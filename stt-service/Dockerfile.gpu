# Распознавание речи на видеокарте.
#
# Отличий от обычного образа три: база с CUDA, сборки torch и ctranslate2 под
# видеокарту, и устройство по умолчанию — cuda. Код тот же самый, выбор
# устройства читается из переменных (см. STT_DEVICE в transcribe_hybrid.py).
FROM nvidia/cuda:12.4.1-cudnn-runtime-ubuntu22.04

ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip ffmpeg git wget ca-certificates \
    && rm -rf /var/lib/apt/lists/*

WORKDIR /app

COPY stt-service/requirements.txt /app/stt-service/requirements.txt
# torch берём из сборки под CUDA 12.4, остальное обычным путём.
RUN pip3 install --no-cache-dir --index-url https://download.pytorch.org/whl/cu124 \
        torch torchaudio \
    && pip3 install --no-cache-dir -r /app/stt-service/requirements.txt

COPY transcribe_hybrid.py /app/transcribe_hybrid.py
COPY vad_utils.py /app/vad_utils.py
COPY text_postprocessing.py /app/text_postprocessing.py
COPY stt-service/main.py /app/stt-service/main.py

ENV PYTHONPATH=/app
ENV PYTHONUNBUFFERED=1
ENV FFMPEG_PATH=ffmpeg
ENV TILTAB_STT_DEVICE=cuda
ENV TILTAB_STT_COMPUTE_TYPE=float16

EXPOSE 8000

WORKDIR /app/stt-service
# Модели подключаются томом в /app/models; ссылка нужна, чтобы относительные пути совпадали с обычным образом.
RUN ln -s /app/models /app/stt-service/models
CMD ["python3", "-m", "uvicorn", "main:app", "--host", "0.0.0.0", "--port", "8000", "--timeout-keep-alive", "0"]
